# Local development: replace with a Turso libsql:// URL and token when testing cloud sync.
TURSO_DATABASE_URL=file:./.tmp/dev.sqlite
TURSO_AUTH_TOKEN=
AUTH_SECRET=replace-with-at-least-32-random-characters
AUTH_URL=http://localhost:3200

# Kakao Login (REST API key and client secret from Kakao Developers).
# Register http://localhost:3200/api/auth/callback/kakao and the production callback URL.
AUTH_KAKAO_ID=
AUTH_KAKAO_SECRET=

# Vercel private Blob store for image uploads.
BLOB_READ_WRITE_TOKEN=

# OpenAI: server-only secret. Never use a NEXT_PUBLIC_ prefix or commit a real key.
OPENAI_API_KEY=
# Optional comma-separated subset of gpt-6-luna,gpt-6-sol,gpt-6-astra. Blank enables all three.
OPENAI_ALLOWED_MODELS=
# Whole-site daily request cap (1-1000). Account limits are 5/minute and 30/day.
OPENAI_GLOBAL_DAILY_LIMIT=100
