# Local development: replace with a Turso libsql:// URL and token when testing cloud sync.
TURSO_DATABASE_URL=file:./.tmp/dev.sqlite
TURSO_AUTH_TOKEN=
AUTH_SECRET=replace-with-at-least-32-random-characters
AUTH_URL=http://localhost:3200

# Vercel private Blob store for image uploads.
BLOB_READ_WRITE_TOKEN=
